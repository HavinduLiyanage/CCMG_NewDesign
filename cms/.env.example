# Use a unique, long, randomly generated secret in each environment.
PAYLOAD_SECRET=replace-with-a-minimum-32-character-secret
DATABASE_URL=postgresql://ccmg_user:replace-me@localhost:5432/ccmg_cms
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Comma-separated, exact origins permitted to make read requests.
CMS_CORS_ORIGINS=http://localhost:4173,https://www.colomboconsultants.lk

# Use these once, from your deployment secret manager, to create the initial
# Owner account. Remove the password afterwards; never commit a real value.
CMS_BOOTSTRAP_OWNER_EMAIL=owner@colomboconsultants.lk
CMS_BOOTSTRAP_OWNER_PASSWORD=replace-with-a-unique-long-password
CMS_BOOTSTRAP_OWNER_NAME=CCMG Owner

# The seed command refuses to write unless this exact confirmation is supplied.
CMS_SEED_CONFIRM=ccmg
